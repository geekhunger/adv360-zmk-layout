#include <behaviors.dtsi>
#include <dt-bindings/zmk/adv2_layout.h>
#include <dt-bindings/zmk/adv360_bt_control.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/backlight.h>

#define MACOS 0
#define WINDOWS 1
#define NUMPAD 2
#define BLUETOOTH 3

#define BTC &btctl ADV360_BT_CANCEL
#define BTA &btctl ADV360_BT_ARM
#define BTS1 &btctl ADV360_BT_SELECT_1
#define BTS2 &btctl ADV360_BT_SELECT_2
#define BTS3 &btctl ADV360_BT_SELECT_3
#define BTS4 &btctl ADV360_BT_SELECT_4
#define BTS5 &btctl ADV360_BT_SELECT_5
#define BTCLR &btctl ADV360_BT_CLEAR

/ {
    behaviors {
        adv2: adv2_resolver {
            compatible = "geekhunger,behavior-adv2-resolver";
            #binding-cells = <1>;
        };

        btctl: adv360_bt_control {
            compatible = "geekhunger,behavior-adv360-bt-control";
            #binding-cells = <1>;
        };

        // Shared NUM controls for macOS and Windows. Shift selects brightness;
        // it is consumed by mod-morph, and the chosen action stays until release.
        num_left: num_media_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_PREV>, <&bl BL_DEC>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        num_down: num_media_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_BRI_DN>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        num_up: num_media_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_BRI_UP>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        num_right: num_media_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_NEXT>, <&bl BL_INC>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        macos_layer {
            display-name = "macOS";
            bindings = <
                &none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none                                      BTA &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                &none &none &adv2 ADV2_W &adv2 ADV2_E &adv2 ADV2_R &adv2 ADV2_F &none   &none &adv2 ADV2_Y &adv2 ADV2_U &adv2 ADV2_I &adv2 ADV2_O &none &none
                &none &adv2 ADV2_A &adv2 ADV2_S &adv2 ADV2_D &adv2 ADV2_T &adv2 ADV2_G &none   &adv2 ADV2_DUAL_DELETE &none   &none &adv2 ADV2_DUAL_BACKSPACE   &none &adv2 ADV2_H &adv2 ADV2_N &adv2 ADV2_K &adv2 ADV2_L &adv2 ADV2_P &none
                &none &adv2 ADV2_Z &adv2 ADV2_X &adv2 ADV2_C &adv2 ADV2_V &adv2 ADV2_B   &kp LCTRL &none   &adv2 ADV2_J &adv2 ADV2_M &adv2 ADV2_COMMA &adv2 ADV2_DOT &adv2 ADV2_SLASH &none
                &none &none &none &none &kp LGUI   &kp SPACE &adv2 ADV2_DUAL_SHIFT_TAB &adv2 ADV2_DUAL_CMD_ESCAPE   &adv2 ADV2_DUAL_CMD_ESCAPE &adv2 ADV2_DUAL_SHIFT_ENTER &mo NUMPAD   &adv2 ADV2_NAV_LEFT &adv2 ADV2_NAV_DOWN &adv2 ADV2_NAV_UP &adv2 ADV2_NAV_RIGHT &none
            >;
        };

        windows_layer {
            display-name = "Windows";
            bindings = <
                &trans &trans &trans &trans &trans &trans &none                                      &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none                                      &none &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none   &trans &kp LALT   &trans &trans   &none &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &kp LGUI &trans   &trans &trans &trans &trans &trans &trans
                &none &trans &trans &trans &kp LALT   &trans &trans &trans   &trans &trans &trans   &trans &trans &trans &trans &none
            >;
        };

        numpad_layer {
            display-name = "NUM";
            bindings = <
                &none &none &none &none &none &none &none                                      &trans &none &none &none &none &none &none
                &none &none &none &none &none &none &none                                      &none &none &none &none &none &none &none
                &tog WINDOWS &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none   &none &none   &none &adv2 ADV2_NAV_BACKSPACE   &none &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none
                &none &none &none &none &none &none   &trans &none   &none &none &kp COMMA &kp DOT &none &none
                &none &none &none &none &none   &kp C_PP &kp LSHIFT &trans   &none &kp RSHIFT &trans   &num_left &num_down &num_up &num_right &none
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
                BTC BTC BTC BTC BTC BTC BTC                                      BTA BTC BTC BTC BTC BTC BTC
                BTC BTC BTC BTC BTC BTC BTC                                      BTC BTC BTC BTC BTC BTC BTC
                BTC BTS1 BTS2 BTS3 BTS4 BTS5 BTC   BTCLR BTC   BTC BTCLR   BTC BTC BTC BTC BTC BTC BTC
                BTC BTC BTC BTC BTC BTC   BTC BTC   BTC BTC BTC BTC BTC BTC
                BTC BTC BTC BTC BTC   BTC BTC BTC   BTC BTC &trans   BTC BTC BTC BTC BTC
            >;
        };
    };
};
